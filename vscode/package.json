{
  "name": "review-hub-vscode",
  "displayName": "Review Hub",
  "description": "Always see what AI coding agents changed in your project, and accept or reject individual hunks. Works with Claude Code, opencode, dsh, Cline, Roo via MCP, and catches direct writes too.",
  "version": "0.3.3",
  "publisher": "review-hub",
  "author": "Tong Duy Dat, Trinh Xuan Hung",
  "license": "MIT",
  "preview": true,
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:review-hub.changes",
    "onCommand:review-hub.setCheckpoint",
    "onCommand:review-hub.openChanges"
  ],
  "contributes": {
    "commands": [
      {
        "command": "review-hub.setCheckpoint",
        "title": "Set Checkpoint",
        "category": "Review Hub",
        "icon": "$(check-all)"
      },
      {
        "command": "review-hub.clearCheckpoint",
        "title": "Clear Checkpoint",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.openChanges",
        "title": "Show Changes",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.openDiff",
        "title": "Open Diff",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.openSideBySide",
        "title": "Open Side-by-Side Diff",
        "icon": "$(split-horizontal)",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.openFile",
        "title": "Open File",
        "icon": "$(go-to-file)",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.acceptAll",
        "title": "Accept All Changes",
        "category": "Review Hub",
        "icon": "$(pass)"
      },
      {
        "command": "review-hub.rejectAll",
        "title": "Reject All Changes",
        "category": "Review Hub",
        "icon": "$(discard)"
      },
      {
        "command": "review-hub.undoFile",
        "title": "Undo File",
        "icon": "$(discard)",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.acceptHunk",
        "title": "Accept Hunk",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.rejectHunk",
        "title": "Reject Hunk",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.acceptFile",
        "title": "Accept File",
        "icon": "$(check)",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.rejectFile",
        "title": "Reject File",
        "icon": "$(chrome-close)",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.stagedAcceptAll",
        "title": "Accept Every Change in This File",
        "icon": "$(check)",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.stagedRejectAll",
        "title": "Reject Every Change in This File",
        "icon": "$(chrome-close)",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.registerMcp",
        "title": "Copy MCP Config for AI Tools",
        "icon": "$(copy)",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.installInstructions",
        "title": "Install Agent Instructions",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.showHubInfo",
        "title": "Show Hub Info",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.copyMcpConfig",
        "title": "Copy MCP Config for AI Tools",
        "icon": "$(copy)",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.copyAgentRules",
        "title": "Copy AI Agent Rules to Clipboard",
        "icon": "$(book)",
        "category": "Review Hub"
      },
      {
        "command": "review-hub.openWebsite",
        "title": "Open Documentation & Website",
        "icon": "$(globe)",
        "category": "Review Hub"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "review-hub",
          "title": "Review Hub",
          "icon": "resources/icons/review-hub.svg"
        }
      ]
    },
    "views": {
      "review-hub": [
        {
          "id": "review-hub.changes",
          "name": "Review Hub",
          "type": "webview"
        }
      ]
    },
    "menus": {

      "explorer/context": [
        {
          "command": "review-hub.openDiff",
          "when": "resourceScheme == file",
          "group": "reviewhub@1"
        },
        {
          "command": "review-hub.openSideBySide",
          "when": "resourceScheme == file",
          "group": "reviewhub@2"
        },
        {
          "command": "review-hub.acceptFile",
          "when": "resourceScheme == file",
          "group": "reviewhub@3"
        },
        {
          "command": "review-hub.rejectFile",
          "when": "resourceScheme == file",
          "group": "reviewhub@4"
        }
      ],
      "editor/title": [
        {
          "command": "review-hub.stagedAcceptAll",
          "when": "resourceScheme == file && reviewHub.hasStagedReview",
          "group": "navigation@1"
        },
        {
          "command": "review-hub.stagedRejectAll",
          "when": "resourceScheme == file && reviewHub.hasStagedReview",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Review Hub",
      "properties": {
        "review-hub.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Review Hub. When off, the hub server is not started and the file watcher is disabled."
        },
        "review-hub.watchDirectWrites": {
          "type": "boolean",
          "default": false,
          "description": "Watch the workspace for direct file writes by agents. Disabled by default: only MCP-proposed changes are tracked."
        },
        "review-hub.autoOpenDiff": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open the review tab as soon as an agent changes a file. Off by default: changed files are marked with a badge in the Explorer (and in the Review Hub panel), and you open the diff by clicking one, so an agent's edits never interrupt what you are doing."
        },
        "review-hub.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "Ignore whitespace-only changes when computing hunks."
        },
        "review-hub.maxFileSize": {
          "type": "number",
          "default": 2097152,
          "description": "Skip hunk-level diffing for files larger than this many bytes (whole-file accept/reject only)."
        },
        "review-hub.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra glob patterns ignored by the watcher and snapshot. Built-in defaults (VCS, deps, caches, ML/data artifacts) always apply; entries here are added to them."
        },
        "review-hub.maxSnapshotFiles": {
          "type": "number",
          "default": 5000,
          "description": "Hard cap on how many files a checkpoint snapshot will read. Keeps activation cheap on very large repositories."
        }
      }
    },
    "keybindings": [
      {
        "command": "review-hub.stagedAcceptAll",
        "key": "alt+shift+a",
        "when": "resourceScheme == file && reviewHub.hasStagedReview"
      },
      {
        "command": "review-hub.stagedRejectAll",
        "key": "alt+shift+r",
        "when": "resourceScheme == file && reviewHub.hasStagedReview"
      }
    ]
  },
  "dependencies": {
    "@review-hub/core": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "diff": "^9.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "@vscode/vsce": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hungtx2001/review-hub"
  },
  "scripts": {
    "package": "vsce package --no-dependencies"
  }
}
